# Root-level ignores. The imported apps keep their own .gitignore files too.
node_modules/
dist/
build/
.turbo/
target/
*.log
.DS_Store
.env
.env.local
.env.*.local
apps/sync/.dmgbuild-venv/

# Local iOS simulator result bundles and exported screenshots. These are
# reproducible verification evidence, never source artifacts.
apps/native-ios/Evidence/

# node_modules symlinks (the trailing-slash rule above only matches directories)
**/node_modules
