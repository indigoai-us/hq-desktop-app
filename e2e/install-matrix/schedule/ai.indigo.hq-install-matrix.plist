<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>ai.indigo.hq-install-matrix</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>__MATRIX_DIR__/run-matrix.sh</string>
    <string>--nightly</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key><string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin:__HOME__/.cargo/bin</string>
    <key>HOME</key><string>__HOME__</string>
    <key>HQ_ROOT</key><string>__HQ_ROOT__</string>
  </dict>
  <key>StartCalendarInterval</key>
  <dict><key>Hour</key><integer>3</integer><key>Minute</key><integer>30</integer></dict>
  <key>StandardOutPath</key><string>__HQ_ROOT__/workspace/e2e-mac/matrix/runs/launchd.out.log</string>
  <key>StandardErrorPath</key><string>__HQ_ROOT__/workspace/e2e-mac/matrix/runs/launchd.err.log</string>
  <key>RunAtLoad</key><false/>
</dict>
</plist>
