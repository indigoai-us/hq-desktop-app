{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "HQ Welcome Preview",
  "version": "0.1.0",
  "identifier": "ai.indigo.hq-welcome-preview",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1424",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "macOSPrivateApi": true,
    "withGlobalTauri": false,
    "security": { "csp": null },
    "windows": [
      {
        "label": "main",
        "title": "HQ Welcome",
        "width": 1280,
        "height": 800,
        "resizable": false,
        "visible": false,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "alwaysOnTop": true,
        "skipTaskbar": true
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.png"],
    "macOS": { "minimumSystemVersion": "12.0", "signingIdentity": "-" },
    "createUpdaterArtifacts": false
  }
}
